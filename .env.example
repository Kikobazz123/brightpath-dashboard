# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# ---- Database -------------------------------------------------------------
# Neon Postgres connection string (Project: brightpath).
# Get it from https://console.neon.tech or `neonctl connection-string`.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# ---- AI provider ----------------------------------------------------------
# The pipeline is provider-agnostic. Set AI_PROVIDER and the matching key.
# Leave everything unset to run in "stub" mode: the pipeline still works
# end-to-end and returns clearly-labelled placeholder output, so the app is
# demoable before any key exists.
#
#   gemini  — Google AI Studio, ~1500 req/day free, no card. Recommended default.
#   groq    — Groq, ~1000 req/day free, very fast. Good failover.
#   openrouter — one key, many free models. Good for swapping models quickly.
#   anthropic  — paid (~$1/$5 per 1M tokens on Haiku 4.5). Not free with a
#                Claude Code subscription; the API is billed separately.
#   stub    — no network calls at all.
AI_PROVIDER="stub"

# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# ---- Failover ------------------------------------------------------------
# A second provider, tried automatically when the primary fails in a way a
# retry could fix: a 429 rate limit, an exhausted daily quota, or a 5xx.
# A 4xx is treated as our bug and is not retried against anyone.
#
# This matters more than it looks. Without it, one exhausted free-tier quota
# means every lead captured until it resets reads NEEDS_REVIEW with no draft —
# the assistant silently stops assisting, exactly when traffic is highest.
#
# Use a DIFFERENT provider, not a second key on the same one: the point is to
# survive that provider's quota, and two keys on one account share it. The
# value is ignored if it matches AI_PROVIDER.
#
# Groq is the natural pair for Gemini — free, fast, separate account.
#   AI_FALLBACK_PROVIDER="groq"   with GROQ_API_KEY set below
#
# Run `pnpm verify:provider` after setting it: it calls the fallback directly,
# so a retired model name or a bad key fails there rather than on the day the
# primary goes down.
AI_FALLBACK_PROVIDER=""

# ---- Speed-to-lead --------------------------------------------------------
# Minutes allowed between a lead arriving and its first real sales action.
# Industry research puts the 5-minute mark as the point where conversion falls
# off a cliff; 15 is a realistic team SLA. Lower it to demo breach behaviour.
SLA_FIRST_TOUCH_MINUTES="15"

# ---- Demo auth ------------------------------------------------------------
# The template ships sign-in pages but no auth backend. Until one is wired,
# requests carry this shared token and resolve to DEMO_TENANT_ID.
#
# Leaving DEMO_API_TOKEN empty opens the API to anyone, which is fine on a
# laptop. In production the app refuses every request instead, rather than
# letting a forgotten variable quietly publish the whole lead database.
DEMO_API_TOKEN="brightpath-demo-token"
DEMO_TENANT_ID="brightpath"

# Recorded as the actor on every activity row a dashboard button creates.
# "system" would be a lie for something a person clicked.
DEMO_ACTOR="rep"

# ---- Rate limits ----------------------------------------------------------
# Requests per minute per IP on the two routes that cannot require a token: the
# public capture form and the webhook receivers. Both run the AI pipeline
# inline, so an unauthenticated loop against them spends the day's model quota.
#
# Counters live in process memory, so on a serverless host each instance keeps
# its own and a cold start forgets them. That stops an accident, not an
# attacker — a real deployment moves the counter into Redis or Vercel KV.
CAPTURE_RATE_LIMIT="20"
WEBHOOK_RATE_LIMIT="60"
